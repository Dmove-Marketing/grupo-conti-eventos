---
const DEST = '/casamentos/';
---

<!doctype html>
<html lang="pt-BR">
  <head>
    <meta charset="UTF-8" />
    <meta name="robots" content="noindex" />
    <link rel="canonical" href={`https://espaco.contieventos.com.br${DEST}`} />
    <title>Redirecionando...</title>
    <script is:inline define:vars={{ DEST }}>
      window.location.replace(DEST + window.location.search + window.location.hash);
    </script>
    <meta http-equiv="refresh" content={`0;url=${DEST}`} />
  </head>
  <body>
    <p>Redirecionando para <a href={DEST}>{DEST}</a>…</p>
  </body>
</html>
